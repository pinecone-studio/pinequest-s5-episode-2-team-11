# Энэ файлыг хуулж ".env.local" гэж нэрлээд утгуудаа бөглөнө (SETUP.md-г үзнэ үү)
# .env.local-ийг GitHub руу ХЭЗЭЭ Ч бүү оруулаарай (.gitignore-д орсон)

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# Claude API → https://console.anthropic.com → API Keys  (зөвхөн сервер дээр ашиглагдана)
ANTHROPIC_API_KEY=sk-ant-...
